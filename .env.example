# Copy to .env and customize
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars

# Directory for the SQLite database and uploads (default: <cwd>/data).
# Point this at a mounted volume when running in a container.
# DATA_DIR=/app/data

# Docker / Coolify (optional — defaults shown)
# PORT=3000
# HOSTNAME=0.0.0.0

# OIDC single sign-on (optional)
# When these are set, an "Sign in with SSO" button appears on the login page.
# OIDC_ISSUER_URL=https://your-idp.example.com
# OIDC_CLIENT_ID=plushdb
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://plushdb.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=Authentik
# Comma-separated allowlist of emails permitted to sign in (recommended).
# If unset, ANY user your IdP authenticates gains full manage access.
# OIDC_ALLOWED_EMAILS=you@example.com,friend@example.com
# Set to "true" only in development to allow non-HTTPS issuers.
# OIDC_ALLOW_INSECURE=false
